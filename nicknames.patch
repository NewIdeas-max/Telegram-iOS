diff --git a/submodules/TelegramCore/Sources/TelegramEngine/Peers/Nicknames.swift b/submodules/TelegramCore/Sources/TelegramEngine/Peers/Nicknames.swift
new file mode 100644
index 00000000..c1aa244a
--- /dev/null
+++ b/submodules/TelegramCore/Sources/TelegramEngine/Peers/Nicknames.swift
@@ -0,0 +1,83 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+internal import TelegramApi
+import MtProtoKit
+
+/// Maximum length of a group nickname, the same as a profile first name.
+public let groupNicknameMaxLength: Int = 64
+
+public enum UpdateChatNicknameError {
+    case generic
+    case tooLong
+    case changeForbidden
+    case flood
+}
+
+/// Sets the current user's nickname in `peerId` (a basic group or a supergroup).
+/// An empty string removes the nickname. Only the member can change their own nickname.
+func _internal_updateOwnChatNickname(account: Account, peerId: PeerId, nickname: String) -> Signal<Never, UpdateChatNicknameError> {
+    let nickname = nickname.trimmingCharacters(in: .whitespacesAndNewlines)
+    if nickname.count > groupNicknameMaxLength {
+        return .fail(.tooLong)
+    }
+    return account.postbox.transaction { transaction -> Api.InputPeer? in
+        return transaction.getPeer(peerId).flatMap(apiInputPeer)
+    }
+    |> castError(UpdateChatNicknameError.self)
+    |> mapToSignal { inputPeer -> Signal<Never, UpdateChatNicknameError> in
+        guard let inputPeer else {
+            return .fail(.generic)
+        }
+        return account.network.request(Api.functions.messages.editChatNickname(peer: inputPeer, nickname: nickname))
+        |> mapError { error -> UpdateChatNicknameError in
+            if error.errorDescription == "NICKNAME_TOO_LONG" {
+                return .tooLong
+            } else if error.errorDescription == "NICKNAME_CHANGE_FORBIDDEN" || error.errorDescription == "CHAT_ADMIN_REQUIRED" {
+                return .changeForbidden
+            } else if error.errorDescription.hasPrefix("FLOOD_WAIT") {
+                return .flood
+            } else {
+                return .generic
+            }
+        }
+        |> mapToSignal { updates -> Signal<Never, UpdateChatNicknameError> in
+            // The server answers with updateChatParticipantNickname and the
+            // messageActionChatParticipantNicknameChanged service message.
+            account.stateManager.addUpdates(updates)
+            return account.postbox.transaction { transaction -> Void in
+                _internal_applyParticipantNickname(transaction: transaction, peerId: peerId, userId: account.peerId, nickname: nickname)
+            }
+            |> castError(UpdateChatNicknameError.self)
+            |> ignoreValues
+        }
+    }
+}
+
+/// Rewrites the nickname on the cached recent messages of `userId` in `peerId`,
+/// so the history shows the current nickname at once. Older messages get it from
+/// the server, which returns the current `from_nickname` when they are fetched.
+/// Same approach as `_internal_updateChatRank` uses for member tags.
+func _internal_applyParticipantNickname(transaction: Transaction, peerId: PeerId, userId: PeerId, nickname: String) {
+    let historyView = transaction.getMessagesHistoryViewState(input: .single(peerId: peerId, threadId: nil), ignoreMessagesInTimestampRange: nil, ignoreMessageIds: Set(), count: 200, clipHoles: true, anchor: .upperBound, namespaces: .just(Set([Namespaces.Message.Cloud])))
+    for entry in historyView.entries {
+        guard let author = entry.message.author, author.id == userId else {
+            continue
+        }
+        transaction.updateMessage(entry.message.id, update: { currentMessage in
+            if (currentMessage.authorGroupNickname ?? "") == nickname {
+                return .skip
+            }
+            var storeForwardInfo: StoreMessageForwardInfo?
+            if let forwardInfo = currentMessage.forwardInfo {
+                storeForwardInfo = StoreMessageForwardInfo(forwardInfo)
+            }
+            var attributes = currentMessage.attributes
+            attributes.removeAll(where: { $0 is ParticipantNicknameMessageAttribute })
+            if !nickname.isEmpty {
+                attributes.append(ParticipantNicknameMessageAttribute(nickname: nickname))
+            }
+            return .update(StoreMessage(id: currentMessage.id, customStableId: nil, globallyUniqueId: currentMessage.globallyUniqueId, groupingKey: currentMessage.groupingKey, threadId: currentMessage.threadId, timestamp: currentMessage.timestamp, flags: StoreMessageFlags(currentMessage.flags), tags: currentMessage.tags, globalTags: currentMessage.globalTags, localTags: currentMessage.localTags, forwardInfo: storeForwardInfo, authorId: currentMessage.author?.id, text: currentMessage.text, attributes: attributes, media: currentMessage.media))
+        })
+    }
+}
