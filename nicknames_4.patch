@@ -0,0 +1,90 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import TelegramPresentationData
+import PresentationDataUtils
+import PromptUI
+
+/// Whether the current user may set their own nickname in this supergroup.
+func peerInfoCanEditOwnGroupNickname(peer channel: TelegramChannel) -> Bool {
+    if case .broadcast = channel.info {
+        return false
+    }
+    guard case .member = channel.participationStatus else {
+        return false
+    }
+    return channel.hasPermission(.editNickname)
+}
+
+/// Whether the current user may set their own nickname in this basic group.
+func peerInfoCanEditOwnGroupNickname(peer group: TelegramGroup) -> Bool {
+    guard case .Member = group.membership else {
+        return false
+    }
+    if case .member = group.role {
+        return !(group.defaultBannedRights?.flags.contains(.banEditNickname) ?? false)
+    }
+    return true
+}
+
+extension PeerInfoScreenNode {
+    func openEditOwnGroupNickname() {
+        let context = self.context
+        let peerId = self.peerId
+        let _ = (context.engine.peers.ownGroupNickname(peerId: peerId)
+        |> take(1)
+        |> deliverOnMainQueue).startStandalone(next: { [weak self] current in
+            guard let self, let controller = self.controller else {
+                return
+            }
+            let strings = self.presentationData.strings
+            let prompt = promptController(
+                context: context,
+                updatedPresentationData: controller.updatedPresentationData,
+                text: strings.GroupNickname_Title,
+                titleFont: .bold,
+                subtitle: strings.GroupNickname_Info,
+                value: current ?? "",
+                placeholder: strings.GroupNickname_Placeholder,
+                characterLimit: groupNicknameMaxLength,
+                displayCharacterLimit: true,
+                apply: { [weak self] value in
+                    guard let self, let value else {
+                        return
+                    }
+                    self.applyOwnGroupNickname(value)
+                }
+            )
+            controller.present(prompt, in: .window(.root))
+        })
+    }
+    
+    private func applyOwnGroupNickname(_ nickname: String) {
+        let _ = (self.context.engine.peers.updateOwnChatNickname(peerId: self.peerId, nickname: nickname)
+        |> deliverOnMainQueue).startStandalone(error: { [weak self] error in
+            guard let self, let controller = self.controller else {
+                return
+            }
+            let strings = self.presentationData.strings
+            let text: String
+            switch error {
+            case .tooLong:
+                text = strings.GroupNickname_ErrorTooLong
+            case .changeForbidden:
+                text = strings.GroupNickname_ErrorForbidden
+            case let .flood(retryIn):
+                if let retryIn, retryIn > 0 {
+                    text = strings.GroupNickname_ErrorFloodRetry(timeIntervalString(strings: strings, value: retryIn)).string
+                } else {
+                    text = strings.GroupNickname_ErrorFlood
+                }
+            case .generic:
+                text = strings.Login_UnknownError
+            }
+            controller.present(textAlertController(context: self.context, updatedPresentationData: controller.updatedPresentationData, title: nil, text: text, actions: [TextAlertAction(type: .defaultAction, title: strings.Common_OK, action: {})]), in: .window(.root))
+        })
+    }
+}
