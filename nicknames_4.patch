diff --git a/submodules/TelegramCore/Sources/SyncCore/ParticipantNicknameMessageAttribute.swift b/submodules/TelegramCore/Sources/SyncCore/ParticipantNicknameMessageAttribute.swift
new file mode 100644
index 00000000..5b9a1f14
--- /dev/null
+++ b/submodules/TelegramCore/Sources/SyncCore/ParticipantNicknameMessageAttribute.swift
@@ -0,0 +1,35 @@
+import Foundation
+import Postbox
+
+/// The author's nickname in the group the message belongs to (`message.from_nickname`).
+///
+/// A group nickname is chosen by the member, is visible only inside that group and,
+/// when present, is shown instead of the author's profile name. It is independent of
+/// the member tag (`ParticipantRankMessageAttribute`): a member can have both.
+public class ParticipantNicknameMessageAttribute: MessageAttribute {
+    public let nickname: String
+    
+    public init(nickname: String) {
+        self.nickname = nickname
+    }
+    
+    required public init(decoder: PostboxDecoder) {
+        self.nickname = decoder.decodeStringForKey("n", orElse: "")
+    }
+    
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeString(self.nickname, forKey: "n")
+    }
+}
+
+public extension Message {
+    /// The author's nickname in this group, or nil when the author uses the profile name.
+    var authorGroupNickname: String? {
+        for attribute in self.attributes {
+            if let attribute = attribute as? ParticipantNicknameMessageAttribute, !attribute.nickname.isEmpty {
+                return attribute.nickname
+            }
+        }
+        return nil
+    }
+}
