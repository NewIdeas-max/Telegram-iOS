diff --git a/submodules/TelegramCore/Sources/TelegramEngine/Peers/Nicknames.swift b/submodules/TelegramCore/Sources/TelegramEngine/Peers/Nicknames.swift
new file mode 100644
index 00000000..90f739ca
--- /dev/null
+++ b/submodules/TelegramCore/Sources/TelegramEngine/Peers/Nicknames.swift
@@ -0,0 +1,240 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+internal import TelegramApi
+import MtProtoKit
+
+/// Maximum length of a group nickname, the same as a profile first name.
+public let groupNicknameMaxLength: Int = 64
+
+public enum UpdateChatNicknameError {
+    case generic
+    case tooLong
+    case changeForbidden
+    /// The server limits how often a nickname can be changed. `retryIn` is the wait in seconds, if known.
+    case flood(retryIn: Int32?)
+}
+
+/// Sets the current user's nickname in `peerId` (a basic group or a supergroup).
+/// An empty string removes the nickname. Only the member can change their own nickname.
+func _internal_updateOwnChatNickname(account: Account, peerId: PeerId, nickname: String) -> Signal<Never, UpdateChatNicknameError> {
+    let nickname = nickname.trimmingCharacters(in: .whitespacesAndNewlines)
+    if nickname.count > groupNicknameMaxLength {
+        return .fail(.tooLong)
+    }
+    return account.postbox.transaction { transaction -> Api.InputPeer? in
+        return transaction.getPeer(peerId).flatMap(apiInputPeer)
+    }
+    |> castError(UpdateChatNicknameError.self)
+    |> mapToSignal { inputPeer -> Signal<Never, UpdateChatNicknameError> in
+        guard let inputPeer else {
+            return .fail(.generic)
+        }
+        // automaticFloodWait is off: the server's rate limit must reach the user as an error,
+        // not as a request that silently retries for hours.
+        return account.network.request(Api.functions.messages.editChatNickname(peer: inputPeer, nickname: nickname), automaticFloodWait: false)
+        |> mapError { error -> UpdateChatNicknameError in
+            if error.errorDescription == "NICKNAME_TOO_LONG" {
+                return .tooLong
+            } else if error.errorDescription == "NICKNAME_CHANGE_FORBIDDEN" || error.errorDescription == "CHAT_ADMIN_REQUIRED" {
+                return .changeForbidden
+            } else if error.errorDescription.hasPrefix("FLOOD_WAIT_") {
+                return .flood(retryIn: Int32(error.errorDescription.dropFirst("FLOOD_WAIT_".count)))
+            } else {
+                return .generic
+            }
+        }
+        |> mapToSignal { updates -> Signal<Never, UpdateChatNicknameError> in
+            // The server answers with updateChatParticipantNickname and the
+            // messageActionChatParticipantNicknameChanged service message.
+            account.stateManager.addUpdates(updates)
+            return account.postbox.transaction { transaction -> Void in
+                _internal_applyParticipantNickname(transaction: transaction, peerId: peerId, userId: account.peerId, nickname: nickname)
+            }
+            |> castError(UpdateChatNicknameError.self)
+            |> ignoreValues
+        }
+    }
+}
+
+/// Rewrites the nickname on the cached recent messages of `userId` in `peerId`,
+/// so the history shows the current nickname at once. Older messages get it from
+/// the server, which returns the current `from_nickname` when they are fetched.
+/// Same approach as `_internal_updateChatRank` uses for member tags.
+func _internal_applyParticipantNickname(transaction: Transaction, peerId: PeerId, userId: PeerId, nickname: String) {
+    _internal_mergeGroupNicknames(transaction: transaction, peerId: peerId, updates: [userId: nickname])
+    
+    let historyView = transaction.getMessagesHistoryViewState(input: .single(peerId: peerId, threadId: nil), ignoreMessagesInTimestampRange: nil, ignoreMessageIds: Set(), count: 200, clipHoles: true, anchor: .upperBound, namespaces: .just(Set([Namespaces.Message.Cloud])))
+    for entry in historyView.entries {
+        guard let author = entry.message.author, author.id == userId else {
+            continue
+        }
+        transaction.updateMessage(entry.message.id, update: { currentMessage in
+            if (currentMessage.authorGroupNickname ?? "") == nickname {
+                return .skip
+            }
+            var storeForwardInfo: StoreMessageForwardInfo?
+            if let forwardInfo = currentMessage.forwardInfo {
+                storeForwardInfo = StoreMessageForwardInfo(forwardInfo)
+            }
+            var attributes = currentMessage.attributes
+            attributes.removeAll(where: { $0 is ParticipantNicknameMessageAttribute })
+            if !nickname.isEmpty {
+                attributes.append(ParticipantNicknameMessageAttribute(nickname: nickname))
+            }
+            return .update(StoreMessage(id: currentMessage.id, customStableId: nil, globallyUniqueId: currentMessage.globallyUniqueId, groupingKey: currentMessage.groupingKey, threadId: currentMessage.threadId, timestamp: currentMessage.timestamp, flags: StoreMessageFlags(currentMessage.flags), tags: currentMessage.tags, globalTags: currentMessage.globalTags, localTags: currentMessage.localTags, forwardInfo: storeForwardInfo, authorId: currentMessage.author?.id, text: currentMessage.text, attributes: attributes, media: currentMessage.media))
+        })
+    }
+}
+
+/// The current user's nickname in `peerId`, or nil if unknown. Read from the group's member
+/// nicknames when they have been loaded, otherwise from the user's own recent messages.
+func _internal_ownGroupNickname(account: Account, peerId: PeerId) -> Signal<String?, NoError> {
+    return account.postbox.transaction { transaction -> String? in
+        if let nicknames = transaction.retrieveItemCacheEntry(id: groupNicknamesEntryId(peerId: peerId))?.get(CachedGroupNicknames.self) {
+            return nicknames.nickname(for: account.peerId) ?? ""
+        }
+        let historyView = transaction.getMessagesHistoryViewState(input: .single(peerId: peerId, threadId: nil), ignoreMessagesInTimestampRange: nil, ignoreMessageIds: Set(), count: 200, clipHoles: true, anchor: .upperBound, namespaces: .just(Set([Namespaces.Message.Cloud])))
+        for entry in historyView.entries.reversed() {
+            if entry.message.author?.id == account.peerId {
+                return entry.message.authorGroupNickname ?? ""
+            }
+        }
+        return nil
+    }
+}
+
+// MARK: - Members' nicknames per group
+
+/// Nicknames of a group's members, stored separately for each group.
+///
+/// Kept in its own cache entry rather than inside the participant models, so data that is
+/// already saved on users' devices (cached participant lists) keeps its format unchanged.
+/// A member without a nickname has no entry.
+public struct CachedGroupNicknames: Codable, Equatable {
+    struct Entry: Codable, Equatable {
+        var userId: Int64
+        var nickname: String
+    }
+    
+    var entries: [Entry]
+    
+    public var nicknames: [EnginePeer.Id: String] {
+        var result: [EnginePeer.Id: String] = [:]
+        for entry in self.entries {
+            result[PeerId(entry.userId)] = entry.nickname
+        }
+        return result
+    }
+    
+    func nickname(for peerId: PeerId) -> String? {
+        let key = peerId.toInt64()
+        return self.entries.first(where: { $0.userId == key })?.nickname
+    }
+}
+
+func groupNicknamesEntryId(peerId: PeerId) -> ItemCacheEntryId {
+    let key = ValueBoxKey(length: 8)
+    key.setInt64(0, value: peerId.toInt64())
+    return ItemCacheEntryId(collectionId: Namespaces.CachedItemCollection.groupNicknames, key: key)
+}
+
+/// Merges nicknames into the group's table. An empty string removes the member's nickname.
+/// Members not mentioned in `updates` are left as they are, so partial lists (a page of
+/// members, search results) never erase what is already known.
+func _internal_mergeGroupNicknames(transaction: Transaction, peerId: PeerId, updates: [PeerId: String]) {
+    if updates.isEmpty {
+        return
+    }
+    let entryId = groupNicknamesEntryId(peerId: peerId)
+    var entries = transaction.retrieveItemCacheEntry(id: entryId)?.get(CachedGroupNicknames.self)?.entries ?? []
+    let previous = entries
+    for (userId, nickname) in updates {
+        let key = userId.toInt64()
+        entries.removeAll(where: { $0.userId == key })
+        if !nickname.isEmpty {
+            entries.append(CachedGroupNicknames.Entry(userId: key, nickname: nickname))
+        }
+    }
+    if entries == previous {
+        return
+    }
+    if let entry = CodableEntry(CachedGroupNicknames(entries: entries)) {
+        transaction.putItemCacheEntry(id: entryId, entry: entry)
+    }
+}
+
+/// The nicknames of `peerId`'s members, updated as they change.
+func _internal_groupNicknames(postbox: Postbox, peerId: PeerId) -> Signal<[EnginePeer.Id: String], NoError> {
+    let key = PostboxViewKey.cachedItem(groupNicknamesEntryId(peerId: peerId))
+    return postbox.combinedView(keys: [key])
+    |> map { views -> [EnginePeer.Id: String] in
+        guard let view = views.views[key] as? CachedItemView else {
+            return [:]
+        }
+        return view.value?.get(CachedGroupNicknames.self)?.nicknames ?? [:]
+    }
+    |> distinctUntilChanged
+}
+
+/// Nickname changes found in a list of supergroup participants. An empty string means "no nickname".
+func groupNicknameUpdates(channelParticipants: [Api.ChannelParticipant]) -> [PeerId: String] {
+    var result: [PeerId: String] = [:]
+    for participant in channelParticipants {
+        let userId: PeerId
+        let nickname: String?
+        switch participant {
+        case let .channelParticipant(data):
+            userId = PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(data.userId))
+            nickname = data.nickname
+        case let .channelParticipantSelf(data):
+            userId = PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(data.userId))
+            nickname = data.nickname
+        case let .channelParticipantCreator(data):
+            userId = PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(data.userId))
+            nickname = data.nickname
+        case let .channelParticipantAdmin(data):
+            userId = PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(data.userId))
+            nickname = data.nickname
+        case let .channelParticipantBanned(data):
+            userId = data.peer.peerId
+            nickname = data.nickname
+        case let .channelParticipantLeft(data):
+            userId = data.peer.peerId
+            nickname = nil
+        }
+        result[userId] = nickname ?? ""
+    }
+    return result
+}
+
+/// Nickname changes found in a basic group's participants. An empty string means "no nickname".
+func groupNicknameUpdates(chatParticipants: Api.ChatParticipants) -> [PeerId: String] {
+    let participants: [Api.ChatParticipant]
+    switch chatParticipants {
+    case let .chatParticipants(data):
+        participants = data.participants
+    case .chatParticipantsForbidden:
+        // Only the current user's own entry is available here; their nickname is
+        // tracked through updates and their own messages instead.
+        participants = []
+    }
+    var result: [PeerId: String] = [:]
+    for participant in participants {
+        let userId: Int64
+        let nickname: String?
+        switch participant {
+        case let .chatParticipant(data):
+            userId = data.userId
+            nickname = data.nickname
+        case let .chatParticipantCreator(data):
+            userId = data.userId
+            nickname = data.nickname
+        case let .chatParticipantAdmin(data):
+            userId = data.userId
+            nickname = data.nickname
+        }
+        result[PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(userId))] = nickname ?? ""
+    }
+    return result
+}
